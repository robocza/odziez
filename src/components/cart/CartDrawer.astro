---
import Cart from '@components/cart/Cart.vue';
import ProductSectionDivider from '@components/product/ProductSectionDivider.astro';
import CloseIcon from '@components/CloseIcon.astro';
import MushroomsAnimation from '@components/animation/Mushrooms.astro';
---

<div
    id="cart-drawer"
    class="fixed top-0 right-0 z-40 flex h-screen w-80 translate-x-full flex-col overflow-y-auto bg-white transition-transform"
    tabindex="-1"
    aria-labelledby="cart-drawer-label"
>
    <div class="grow">
        <h5 id="cart-drawer-label" class="text-green mt-8 mb-4 px-4 text-left text-5xl lowercase">Koszyk</h5>
        <ProductSectionDivider />
        <button type="button" data-cart-drawer-hide aria-controls="cart-drawer" class="absolute top-2.5 right-2.5 cursor-pointer hover:opacity-50">
            <CloseIcon />
            <span class="sr-only">Zamknij koszyk</span>
        </button>
        <Cart client:only="vue" />
    </div>

    <div class="self-end">
        <MushroomsAnimation />
    </div>
</div>
