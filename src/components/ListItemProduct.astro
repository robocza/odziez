---
import type { CollectionEntry } from 'astro:content';
import { getProduct } from '../productRepository';

interface Props {
    productCollectionEntry: CollectionEntry<'product'>;
}

const { productCollectionEntry } = Astro.props;

const product = getProduct(productCollectionEntry.data.id);
---

<div class="py-8 sm:py-2 text-center">
    <a href={`/produkt/${productCollectionEntry.id}`}>
        <img src={product.images[0].url} alt={product.images[0].alt} class="mx-auto max-h-96 lg:max-h-48 xl:max-h-60 dawid:max-h-96 border border-green" />
    </a>
    <h2 class="my-2 text-lg text-green uppercase">{product.name}</h2>
    <a class="inline-block w-48 rounded-full bg-green px-4 py-2 uppercase text-white hover:opacity-50" href={`/produkt/${productCollectionEntry.id}`}>
        Zobacz szczegóły</a
    >
</div>
