---
import Intro from '@components/story/Intro.md';
import Manifesto from '@components/story/Manifesto.md';
import Team from '@components/story/Team.md';
import LinkButtonReverse from '@components/LinkButtonReverse.astro';
---

<div class="bg-[length:25px] bg-repeat-y text-sm sm:text-base">
    <div
        class="prose-invert prose-headings:mb-4 prose-headings:mt-8 prose-headings:font-pixel prose-headings:text-3xl prose-headings:uppercase prose-headings:tracking-wide prose-p:mb-4 prose-a:underline hover:prose-a:bg-white hover:prose-a:text-green prose-headings:sm:text-3xl prose-headings:md:text-4xl text-phosphorescent"
    >
        <Intro />
    </div>
    <div>
        <h2 class="mt-8 mb-4 sm:mt-16 sm:mb-8 text-5xl text-phosphorescent lowercase font-title">Hardcore Garden Manifesto</h2>
    </div>
    <div
        class="prose-invert prose-headings:mb-4 prose-headings:mt-8 prose-headings:font-pixel prose-headings:text-3xl prose-headings:uppercase prose-headings:tracking-wide prose-p:mb-4 prose-a:underline hover:prose-a:bg-white hover:prose-a:text-green prose-headings:sm:text-3xl prose-headings:md:text-4xl text-phosphorescent"
    >
        <Manifesto />
    </div>
    <div class="mx-auto my-10 text-center lg:hidden">
        <LinkButtonReverse url="/#odziez" text="Zobacz odzież" />
    </div>
    <div
        class="prose-invert prose-headings:mb-4 prose-headings:mt-8 prose-headings:font-pixel prose-headings:text-3xl prose-headings:uppercase prose-headings:tracking-wide prose-p:mb-4 hover:prose-a:bg-white hover:prose-a:text-green prose-headings:sm:text-3xl prose-headings:md:text-4xl text-phosphorescent"
    >
        <Team />
    </div>
</div>
