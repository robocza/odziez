---
import Intro from '@components/story/Intro.md';
import Manifesto from '@components/story/Manifesto.md';
import Team from '@components/story/Team.md';
import LinkButtonReverse from '@components/LinkButtonReverse.astro';
---

<div class="bg-[length:25px] bg-repeat-y text-sm sm:text-base">
    <div
        class="prose-h2:mt-8 prose-h2:mb-4 prose-h2:sm:mt-16 prose-h2:sm:mb-8 prose-h2:text-5xl prose-h2:text-phosphorescent prose-h2:lowercase prose-h2:font-title prose-invert prose-headings:mb-4 prose-headings:mt-8 prose-headings:uppercase prose-headings:text-base prose-headings:font-bold prose-p:mb-4 prose-a:underline prose-a:hover:bg-white prose-a:hover:text-green text-phosphorescent"
    >
        <Intro />
        <Manifesto />
    </div>
    <div class="mx-auto my-10 text-center lg:hidden">
        <LinkButtonReverse url="/#odziez" text="Zobacz odzież" />
    </div>
    <div
        class="prose-h2:mt-8 prose-h2:mb-4 prose-h2:sm:mt-16 prose-h2:sm:mb-8 prose-h2:text-5xl prose-h2:text-phosphorescent prose-h2:lowercase prose-h2:font-title prose-invert prose-headings:mb-4 prose-headings:mt-8 prose-headings:uppercase prose-headings:text-base prose-headings:font-bold prose-p:mb-4 prose-a:underline prose-a:hover:bg-white prose-a:hover:text-green text-phosphorescent"
    >
        <Team />
    </div>
</div>
