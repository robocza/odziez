---
import SimpleCenteredWithBackground from '@layouts/SimpleCenteredWithBackground.astro';
import Central from '@layouts/elements/arrangement/Central.astro';
---

<SimpleCenteredWithBackground title="Odzież Robocza - drop N°.3">
    <Central>
        <div class="max-w-[320px]">
            <img class="w-full max-w-4xl" src="/assets/hardcore-garden-logo.svg" alt="Odzież Robocza - Hardcore Garden - drop N°.3" />
            <div class="text-phosphorescent my-2 text-center text-base uppercase sm:my-4 sm:text-2xl">Odzież Robocza drop#3</div>
        </div>
    </Central>

    <div class="font-title text-phosphorescent text-stroke-title my-4 block text-4xl lowercase sm:my-16 sm:text-9xl">Dziękujemy</div>
    <div class="text-green mt-2 sm:mt-8">
        Przygotowujemy Twoje zamówienie i wyślemy je najszybciej jak potrafimy.<br />
        O postępie będziemy pisać na Twój adres e-mail.
    </div>
    <a
        class="bg-green my-2 inline-block rounded-md px-4 py-2 text-sm text-white uppercase hover:opacity-50 sm:mt-8 sm:text-base md:px-8 md:py-4"
        href="/opowiesc"
    >
        Przeczytaj artykuł</a
    >
    <div class="text-green mt-4 sm:mt-16">
        Problem z zamówieniem?
        <a class="block underline hover:opacity-50" href="mailto:grupa@robocza.org">grupa@robocza.org</a>
    </div>
</SimpleCenteredWithBackground>

<script>
    import { emptyCart } from '../store/cart';

    emptyCart();
</script>
