---
import Layout from '@layouts/Layout.astro';
import Story from '@components/Story.astro';
import HardcoreGarden from '@components/HardcoreGarden.astro';
import Header from '@components/Header.astro';
import CartDrawer from '@components/cart/CartDrawer.astro';
import Footer from '@components/Footer.astro';
---

<Layout title="Odzież Robocza - drop N°.3">
    <div class="mx-auto md:min-w-fit">
        <Header showBackButton={true} />
        <div class="bg-[url(/assets/hardcore-garden-bg.jpg)] bg-cover bg-center bg-no-repeat text-white">
            <div class="pt-10 sm:px-10">
                <div class="mx-auto max-w-2xl">
                    <div class="px-10 pb-10 sm:px-0 sm:pb-0">
                        <HardcoreGarden />
                        <Story />
                        <hr class="sm:border-phosphorescent sm:bg-phosphorescent mt-8 hidden sm:block sm:h-px" />
                    </div>
                    <div class="px-8 py-4 sm:px-0 sm:py-0">
                        <Footer />
                    </div>
                </div>
            </div>
        </div>
    </div>
    <CartDrawer />
</Layout>
